            <section class="banner-img">
                <div class="container">
                    <div class="banner-img__content">
                        <h2 class="section__title banner-img__title">Подберем тур по вашим пожеланиям</h2>
                    </div>
                </div>
            </section>
            <section class="section section--light-grey">
                <div class="container">
                    <h2 class="section__title section__title--dark">Оставьте отзыв</h2>
                    <form id="myForm" class="form" action="https://formspree.io/f/xojgoeee" method="POST" novalidate>
                        <div class="form__row">
                            <div class="input-wrapper">
                                <input id="name" type="text" name="username" placeholder="Ваше имя" class="form__input"
                                    autocomplete="on" required>
                                <div class="error">Введите имя длиной не менее 2 символов</div>
                            </div>
                            <div class="input-wrapper">
                                <input id="social-link" type="url" name="link" placeholder="Ссылка на профиль VK"
                                    class="form__input" autocomplete="on">
                                <div class="error">Введите ссылку вида https://vk.ru/id123</div>
                            </div>
                        </div>
                        <div class="form__row">
                            <div class="input-wrapper">
                                <textarea id="message" class="form__input form__input-textarea" name="message"
                                    placeholder="Напишите свой честный отзыв ;)" required></textarea>
                                <div class="error">Ваш отзыв должен быть не менее 10 символов</div>
                            </div>
                        </div>
                        <div class="form__controls">
                            <div class="form__controls-title">Какими услугами компании пользуетесь?</div>
                            <div class="form__checkes">
                                <label>
                                    <input type="checkbox" value="Остров обезьян" name="used-service" class="form__check" id="monkeys-island">
                                    <div class="form__check-text">Остров обезьян</div>
                                </label>
                                <label>
                                    <input type="checkbox" value="Тур по Тайланду" name="used-service" class="form__check" id="tayland">
                                    <div class="form__check-text">Тур по Тайланду</div>
                                </label>
                                <label>
                                    <input type="checkbox" value="Водопад Янг-бей" name="used-service" class="form__check" id="young-bei">
                                    <div class="form__check-text">Водопад Янг-бей</div>
                                </label>
                                <label>
                                    <input type="checkbox" value="Тур по Индонезии" name="used-service" class="form__check" id="indonesia">
                                    <div class="form__check-text">Тур по Индонезии</div>
                                </label>
                                <label>
                                    <input type="checkbox" value="Никакими" name="used-service" class="form__check" id="nothing">
                                    <div class="form__check-text">Никакими</div>
                                </label>
                                <label>
                                    <input type="checkbox" value="Тур по Бали" name="used-service" class="form__check" id="bali">
                                    <div class="form__check-text">Тур по Бали</div>
                                </label>
                                <label>
                                    <input type="checkbox" value="Другое" name="used-service" class="form__check" id="another">
                                    <div class="form__check-text">Другое</div>
                                </label>
                            </div>
                        </div>
                        <div class="error">Выберите хотя бы одну услугу</div>
                        <div class="form__bttns">
                            <button type="reset" id="resetForm" class="btn btn__reset">Очистить</button>
                            <button type="submit" id="sendButton" class="btn btn__submit">Отправить</button>
                        </div>
                    </form>
                </div>
            </section>

    <div id="myModal" class="modal">
