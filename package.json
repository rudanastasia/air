{
  "name": "air",
  "version": "1.0.0",
  "private": true,
  "description": "Air site",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:ts": "tsc",
    "build:site": "eleventy",
    "build": "run-s build:site build:ts",
    "start": "run-p start:site start:ts",
    "start:site": "eleventy --serve",
    "start:ts": "tsc --watch --preserveWatchOutput",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudanastasia/air.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rudanastasia/air/issues"
  },
  "homepage": "https://rudanastasia.github.io/air/welcome",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "npm-run-all2": "^9.0.4",
    "prettier": "3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  }
}
